# Copy this file to .env.local for local development (npm run dev).
# .env.local is git-ignored. On Vercel, set the same names under
# Project -> Settings -> Environment Variables instead.
#
# You only need the providers you want to use. Leave the others empty.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Hard cap on trainer requests per day (all features together). Default 50.
TRAINER_DAILY_LIMIT=50

# Optional: makes the daily cap reliable on Vercel (free Upstash Redis).
# Vercel's Upstash integration may name these KV_REST_API_URL / KV_REST_API_TOKEN;
# either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
